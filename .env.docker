# ═══════════════════════════════════════════════════════════════════
# Docker Compose Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════

# ─── Infrastructure ───────────────────────────────────────────────
POSTGRES_USER=axly_user
POSTGRES_PASSWORD=axly_password
POSTGRES_DB=axly_main

RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ─── Security ─────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here

# ─── AI Service (Optional - leave blank to disable AI features) ──
LLM_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4

GROQ_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENROUTER_API_KEY=

# ─── Frontend ─────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
