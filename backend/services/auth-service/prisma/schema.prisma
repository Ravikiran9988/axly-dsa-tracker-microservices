datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  name  String @id
  users User[]

  @@map("roles")
}

model User {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  roleId            String    @map("role") @default("user")
  role              Role      @relation(fields: [roleId], references: [name])
  avatarUrl         String?   @map("avatar_url")
  institution       String?
  passwordHash      String?   @map("password_hash")
  emailVerified     Boolean   @default(false) @map("email_verified")
  isActive          Boolean   @default(true) @map("is_active")
  lastActiveAt      DateTime? @map("last_active_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  authTokens        AuthToken[]
  dailyActivities   UserDailyActivity[]
  auditLogs         AuditLog[]

  @@index([email])
  @@index([roleId])
  @@map("users")
}

model UserDailyActivity {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityDate DateTime @map("activity_date") @db.Date
  activityType String   @default("login") @map("activity_type")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([userId, activityDate])
  @@index([userId, activityDate])
  @@map("user_daily_activity")
}

model AuthToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  tokenType  String    @map("token_type") // 'verification', 'otp_verification', 'password_reset'
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  usedAt     DateTime? @map("used_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([tokenHash])
  @@index([userId])
  @@map("auth_tokens")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?  @map("actor_id")
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  details      Json?
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([actorId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}
