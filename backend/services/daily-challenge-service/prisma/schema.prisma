datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model DailyQuestion {
  id                 String   @id @default(uuid())
  questionId         String   @map("question_id") // Soft link to Canonical Question in Question Service
  date               DateTime @unique @db.Date
  createdBy          String   @map("created_by")  // Soft link to Auth Service User
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([date])
  @@map("daily_questions")
}
