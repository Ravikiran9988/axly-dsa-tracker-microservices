datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model DailyChallenge {
  id         String   @id @default(uuid())
  date       DateTime @unique @db.Date
  questionId String   
  status     String   @default("PUBLISHED") // PUBLISHED, EXPIRED
  createdAt  DateTime @default(now())
}
